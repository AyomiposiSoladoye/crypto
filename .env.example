# From https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Comma-separated channel usernames (without @)
TG_CHANNELS=
# Optional
TG_SESSION=secrets/telegram
DB_PATH=data/community.db
# Member chat text in groups: redact (keep, with phones/emails/wallets/usernames masked) or drop
TG_MEMBER_TEXT=redact
